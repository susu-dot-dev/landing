    "test": "rstest run",
    "test:watch": "rstest watch",
    "coverage": "rstest run --coverage",
    "check": "pnpm run lint && pnpm run typecheck && pnpm run coverage",
    "ci": "pnpm run check && pnpm run build"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
